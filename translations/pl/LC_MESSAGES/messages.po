#: templates/index.html:604
msgid "Discover music for every mood"
msgstr "Odkryj muzykę na dzisiejszy nastrój"

#: templates/index.html:605
msgid "Genres and Moods"
msgstr "Gatunki i nastroje"

#: templates/index.html:629
msgid ""
"Manage your account settings and\n"
"                                    preferences"
msgstr "Zarządzaj swoimi ustawieniami konta oraz preferencjami"

#: templates/index.html:670
msgid "Dark Mode"
msgstr "Tryb ciemny"

#: templates/index.html:672
msgid ""
"Quickly toggle between light and\n"
"                                        dark modes for a personalized."
msgstr "Szybko przełączaj pomiędzy trybem ciemnym a jasnym."

